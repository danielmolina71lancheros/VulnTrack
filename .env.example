# ------------------------------------------------------------------
# VulnTrack - Plantilla de variables de entorno
# Copie este archivo a .env y rellene con valores reales:
#   cp .env.example .env
# NUNCA versione el archivo .env con valores reales.
# ------------------------------------------------------------------

# Configuración de Base de Datos (superusuario que crea la BD)
DB_NAME=vulntrack
DB_USER=admin_db
DB_PASSWORD=cambia_esta_password

# Cuenta de bajo privilegio que usa la API (debe existir en init.sql)
DB_APP_USER=app_user
DB_APP_PASSWORD=cambia_esta_password_de_app

# Configuración de Redis
# Host del servicio Redis (nombre del contenedor en docker-compose)
REDIS_HOST=securehub-redis
REDIS_PASSWORD=cambia_esta_password_redis

# Orígenes permitidos por CORS, separados por comas (CSV).
# En producción, restrinja a los dominios reales del frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost

# Firma criptográfica de los JWT. Use una cadena larga y aleatoria, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=genere_un_secreto_aleatorio_largo

# (Opcional) API Key de NIST/NVD para evitar rate-limit en la ingesta de CVEs
NVD_API_KEY=
